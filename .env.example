# Copie para .env.local e preencha. NUNCA commite valores reais.

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Agenda

# Supabase (valores exibidos por `pnpm db:start` no ambiente local)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SOMENTE SERVIDOR — nunca use o prefixo NEXT_PUBLIC_ nesta chave
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (anti-bot da página pública)
# Chaves de teste oficiais podem ser usadas localmente.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# SOMENTE SERVIDOR — segredo aleatório (ex.: `openssl rand -base64 32`) para hash de IPs
IP_HASH_SECRET=

# --- Opcionais / fases futuras ---
# E-mail transacional (quando necessário)
RESEND_API_KEY=
# Rota de envio de e-mails de cobrança chamada pelo pg_cron/pg_net (fase B4+)
BILLING_CRON_SECRET=
# Gateway de pagamento aprovado (fase B5)
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
