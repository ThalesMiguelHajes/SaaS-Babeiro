{
  "name": "saas-cabeleireiro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "scripts/db-types.sh",
    "db:types:harness": "scripts/db-types.sh --harness",
    "db:test": "supabase test db",
    "db:test:harness": "scripts/db-test.sh",
    "bootstrap:super-admin": "node --env-file-if-exists=.env.local scripts/bootstrap-super-admin.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm db:test:harness",
    "test:integration": "vitest run --config vitest.integration.config.mts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^7.0.9",
    "@supabase/ssr": "^0.12.7",
